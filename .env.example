# Supabase (storefront catalog, orders, reviews, admin login).
# Copy the project URL and publishable (anon) key from the Supabase / Lovable
# Cloud dashboard. The VITE_* pair is inlined at BUILD time, so on Vercel set
# them before the build; the unprefixed pair is read by the server at runtime.
# Never put a service-role key in a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Order notification emails (owner + customer), sent client-side via EmailJS
# (https://www.emailjs.com) — no backend required. See src/lib/notifications.ts.
#
# Setup:
#   1. Create a free EmailJS account and connect an email service (Gmail, etc.)
#      -> copy its Service ID into VITE_EMAILJS_SERVICE_ID
#   2. In Account > General, copy your Public Key into VITE_EMAILJS_PUBLIC_KEY
#   3. Create two email templates and copy their IDs below. Both templates can
#      use the same variables, sent as template_params:
#        {{to_email}}         — recipient (owner's email or customer's email)
#        {{order_number}}     {{customer_name}}    {{customer_phone}}
#        {{customer_email}}   {{delivery_address}} {{delivery_slot}}
#        {{payment_method}}   {{items_summary}}    {{subtotal}}
#        {{discount_total}}   {{delivery_fee}}     {{total}}
#        {{owner_email}}
#
# Until these are set, order notifications are skipped (a warning is logged
# to the browser console) — the checkout flow itself still works normally.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_ADMIN_ID=
VITE_EMAILJS_TEMPLATE_CUSTOMER_ID=
